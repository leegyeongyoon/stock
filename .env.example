# Database Configuration
DATABASE_URL=postgresql://stock:stock123@localhost:5432/stock_trading

# KIS API (한국투자증권)
KIS_APP_KEY=your-app-key
KIS_APP_SECRET=your-app-secret
KIS_ACCOUNT_NO=1234567801        # 계좌번호 8자리+2자리
KIS_IS_MOCK=true                 # true=모의투자, false=실전투자

# Kiwoom API (Windows only, legacy)
KIWOOM_ACCOUNT=

# Logging
LOG_LEVEL=INFO

# Trading Settings
MAX_POSITION_SIZE=0.1
MAX_DAILY_LOSS=0.03
MAX_POSITIONS=10
INITIAL_CAPITAL=5000000          # 500만원

# Backtest Settings
BACKTEST_INITIAL_CAPITAL=100000000

# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
